@page "/loans"
@inject HttpClient Http

<h3>Loans</h3>


@if (loans == null)
{
    <p>Loading...</p>
}
else
{
    <table class="table">
        <thead>
        <tr>
            <th>Reader ID</th>
            <th>Book ID</th>
            <th>Loan out date</th>
            <th>Return date</th>
            <th>Actions</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var loan in loans)
        {
            <tr>
                @if (editLoan != null && editLoan.Id == loan.Id)
                {
                    <td colspan="4">
                        <EditForm Model="@editLoan" OnValidSubmit="()=>UpdateLoan(editLoan.Id)">
                            <DataAnnotationsValidator />
                            <input class="form-control " @bind="editLoan.UserId" />
                            <input class="form-control mt-1" @bind="editLoan.BookId" />
                            <input class="form-control mt-1" @bind="editLoan.LoanDate" />
                            <input class="form-control mt-1" @bind="editLoan.LoanReturnDate" />
                            <button class="btn btn-sm btn-success mt-1" type="submit">Save</button>
                            <button class="btn btn-sm btn-secondary mt-1 ms-1" type="button" @onclick="()=>editLoan = null">Cancel</button>
                        </EditForm>
                    </td>
                }
                else
                {
                    <td>@loan.UserId</td>
                    <td>@loan.BookId</td>
                    <td>@loan.LoanDate</td>
                    <td>@loan.LoanReturnDate</td>
                    <td>
                        <button class="btn btn-primary btn-sm" @onclick="() => StartEdit(loan)">Edit</button>
                        <button class="btn btn-danger btn-sm ms-1" @onclick="() => DeleteLoan(loan.Id)">🗑️</button>
                    </td>
                }
            </tr>
        }
    </tbody>
    </table>
}

<h4>New Loan</h4>

<EditForm Model="@newLoan" OnValidSubmit="AddLoan">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-2">
        <input class="form-control" type="number" @bind="newLoan.UserId" placeholder="Reader ID" />
    </div>
    <div class="mb-2">
        <input class="form-control" type="number" @bind="newLoan.BookId" placeholder="Book ID" />
    </div>
    <div class="mb-2">
        <input class="form-control" type="date" @bind="newLoan.LoanDate" />
    </div>
    <div class="mb-2">
        <input class="form-control" type="date" @bind="newLoan.LoanReturnDate" />
    </div>
    <button class="btn btn-primary" type="submit">Loan out</button>
</EditForm>

@code
{
    private List<LibraryApp.Shared.Models.Loan>? loans;

    private LibraryApp.Shared.Models.Loan newLoan = new()
    {
        LoanDate = DateTime.Today,
        LoanReturnDate = DateTime.Today.AddDays(7)
    };

    private LibraryApp.Shared.Models.Loan editLoan = new();
    
    protected override async Task OnInitializedAsync()
    {
        loans = await Http.GetFromJsonAsync<List<LibraryApp.Shared.Models.Loan>>("api/Loan");
    }

    private async Task AddLoan()
    {
        var response = await Http.PostAsJsonAsync("api/Loan", newLoan);
        if (response.IsSuccessStatusCode)
        {
            loans = await Http.GetFromJsonAsync<List<LibraryApp.Shared.Models.Loan>>("api/Loan");
            newLoan = new() { LoanDate = DateTime.Today, LoanReturnDate = DateTime.Today.AddDays(7) };
        }
    }
    
    private void StartEdit(LibraryApp.Shared.Models.Loan loan)
    {
        editLoan = new()
        {
            Id = loan.Id,
            BookId = loan.BookId,
            UserId = loan.UserId,
            LoanDate = loan.LoanDate,
            LoanReturnDate = loan.LoanReturnDate
        };
    }
    
    private async Task UpdateLoan(int id)
    {
        var response = await Http.PutAsJsonAsync($"api/Loan/{id}", editLoan);
        if (response.IsSuccessStatusCode)
        {
            editLoan = null;
            await OnInitializedAsync();
        }
    }
    
    private async Task DeleteLoan(int id)
    {
        await Http.DeleteAsync($"api/Loan/{id}");
        loans = await Http.GetFromJsonAsync<List<LibraryApp.Shared.Models.Loan>>("api/Loan");
    }
}
