@page "/readers"
@using LibraryApp.Shared.Models
@inject HttpClient Http

<h3>Readers</h3>
@if (readers == null)
{
    <p>Loading...</p>
}
else
{
    <table class="table">
        <thead>
        <tr>
            <th>Name</th>
            <th>Location</th>
            <th>Date of Birth</th>
            <th>Actions</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var reader in readers)
        {
            <tr>
                @if (editReader != null && editReader.Id == reader.Id)
                {
                    <td colspan="3">
                        <EditForm Model="@editReader" OnValidSubmit="()=>UpdateReader(editReader.Id)">
                            <DataAnnotationsValidator />
                            <input class="form-control " @bind="editReader.Name" />
                            <input class="form-control mt-1" @bind="editReader.Location" />
                            <input class="form-control mt-1" type="number" @bind="editReader.DateOfBirth" />
                            <button class="btn btn-sm btn-success mt-1" type="submit">Save</button>
                            <button class="btn btn-sm btn-secondary mt-1 ms-1" type="button" @onclick="()=>editReader = null">Cancel</button>
                        </EditForm>
                    </td>
                }
                else
                {
                    <td>@reader.Name</td>
                    <td>@reader.Location</td>
                    <td>@reader.DateOfBirth</td>
                    <td>
                        <button class="btn btn-primary btn-sm" @onclick="() => StartEdit(reader)">Edit</button>
                        <button class="btn btn-danger btn-sm" @onclick="() => DeleteReader(reader.Id)">🗑️</button>
                    </td>
                }
            </tr>
        }
        </tbody>
    </table>
}

<h4>Add new Reader</h4>

<EditForm Model="@newReader" OnValidSubmit="AddReader">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-2">
        <input class="form-control" @bind="newReader.Name" placeholder="Name" />
    </div>
    <div class="mb-2">
        <input class="form-control" @bind="newReader.Location" placeholder="Location" />
    </div>
    <div class="mb-2">
        <input class="form-control" type="number" @bind="newReader.DateOfBirth" placeholder="Date of Birth" />
    </div>
    <button class="btn btn-primary" type="submit">Add</button>
</EditForm>

@code 
{
    private List<Reader>? readers;
    private Reader newReader = new();
    private Reader? editReader = new();

    protected override async Task OnInitializedAsync()
    {
        readers = await Http.GetFromJsonAsync<List<Reader>>("api/Reader");
    }

    private async Task AddReader()
    {
        var response = await Http.PostAsJsonAsync("api/Reader", newReader);
        if (response.IsSuccessStatusCode)
        {
            readers = await Http.GetFromJsonAsync<List<Reader>>("api/Reader");
            newReader = new();
        }
    }

    private void StartEdit(Reader reader)
    {
        editReader = new()
        {
            Id = reader.Id,
            DateOfBirth = reader.DateOfBirth,
            Location = reader.Location,
            Name = reader.Name
        };
    }
    
    private async Task UpdateReader(int id)
    {
        var response = await Http.PutAsJsonAsync($"api/Reader/{id}", editReader);
        if (response.IsSuccessStatusCode)
        {
            editReader = null;
            await OnInitializedAsync();
        }
    }
    
    private async Task DeleteReader(int id)
    {
        await Http.DeleteAsync($"api/Reader/{id}");
        readers = await Http.GetFromJsonAsync<List<Reader>>("api/Reader");
    }
}