@page "/register"
@inject HttpClient Http
@inject NavigationManager Nav

<h3>Register</h3>

<EditForm Model="@model" OnValidSubmit="DoRegister">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <input class="form-control mb-2" @bind="model.Email" placeholder="Email" />
    <input class="form-control mb-2" type="password" @bind="model.Password" placeholder="Password (min 6)" />
    <div class="form-check mb-2">
        <input class="form-check-input" type="checkbox" id="asAdmin" @bind="model.AsAdmin" />
        <label class="form-check-label" for="asAdmin">Register as Admin (dev)</label>
    </div>
    <button class="btn btn-primary" type="submit">Register</button>
</EditForm>

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert alert-info mt-2">@message</div>
}

@code {
    private RegisterRequest model = new();
    private string? message;

    public class RegisterRequest
    {
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
        public bool AsAdmin { get; set; }
    }

    private async Task DoRegister()
    {
        var res = await Http.PostAsJsonAsync("api/Auth/register", model);
        if (res.IsSuccessStatusCode)
        {
            message = "Registration successful. You can now log in.";
            await Task.Delay(1000);
            Nav.NavigateTo("/login");
        }
        else
        {
            var body = await res.Content.ReadAsStringAsync();
            message = $"Registration failed: {body}";
        }
    }
}